# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (get from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_chat_id_here

# Database path (relative to project root)
DATABASE_URL=sqlite+aiosqlite:///data/jobhunter.db

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Polling interval in minutes
POLL_INTERVAL_MINUTES=15

# Minimum match score to trigger resume generation & notification (0-100)
MIN_MATCH_SCORE=70

# ===================== AUTOMATED COLD EMAIL OUTREACH =====================
# Google 16-character App Password (get from https://myaccount.google.com/apppasswords)
SMTP_USER=salilvaidya003@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password

# Email Discovery API Keys (optional — get free tier from hunter.io or apollo.io)
HUNTER_API_KEY=your_hunter_api_key_here
APOLLO_API_KEY=your_apollo_api_key_here
